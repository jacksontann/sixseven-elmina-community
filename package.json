{
  "name": "elmina",
  "version": "0.1.0",
  "private": true,
  "description": "Elmina - a concept prototype neighbourhood app for City of Elmina residents (SDP University Hackathon 2026). Not an official Sime Darby Property service.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
