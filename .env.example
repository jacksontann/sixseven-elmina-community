# Elmina demo prototype. Every setting is optional for a local demo.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Embedded PostgreSQL (PGlite) folder. One Node process per folder. DATABASE_URL overrides it.
DATA_DIR=.data/elmina-demo
DATABASE_URL=

# Signs the login cookie. Generated into .data/secrets.json if blank; set a stable random value for hosting.
SESSION_SECRET=
